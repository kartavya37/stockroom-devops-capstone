# Copy this file to terraform.tfvars and change the values.
# Do not commit the file terraform.tfvars.
# Do not put an AWS access key in this file. Use the AWS CLI instead:
#   aws configure

aws_region         = "ap-south-1"
project_name       = "stockroom"
environment        = "dev"
owner              = "kartavya37"
kubernetes_version = "1.31"
node_instance_type = "t3.medium"
node_desired_size  = 2
node_min_size      = 2
node_max_size      = 4
